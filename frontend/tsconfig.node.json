{
  "compilerOptions": {
    "composite": true,
    // Redirect emit out of the project root. `composite` forces emit, and
    // without this `tsc -b` (run by `npm run build`) wrote vite.config.js next
    // to the source, and a stale compiled `.js` config resolves before the
    // `.ts` one. Emitting to a cache dir keeps the source file the single
    // resolution target.
    "outDir": "./node_modules/.cache/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
