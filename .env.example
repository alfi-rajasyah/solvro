# Solvro local dev env. Copy to .env and adjust as needed.
# WARNING: these defaults are for local development only — rotate before any deploy.

# Postgres
POSTGRES_USER=solvro
POSTGRES_PASSWORD=solvro_dev
POSTGRES_DB=solvro
POSTGRES_PORT=5432

# Backend
# JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-32-character-or-longer-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Frontend has no env vars — it derives the API URL from window.location at
# runtime (always `<page-protocol>://<page-hostname>:3000`). The frontend
# image works on any address without rebuilding.

# Used by Prisma when running host-side (not in Docker). The compose `backend`
# service overrides this via its own environment block to talk to `postgres:5432`.
DATABASE_URL=postgresql://solvro:solvro_dev@localhost:5432/solvro?schema=public

# ----------------------------------------------------------------------------
# Server-side (docker-compose.prod.yml) — pulls prebuilt images from GHCR.
# Only needed on the deployment host; ignored by the dev compose file.
# ----------------------------------------------------------------------------
# Your GitHub username or org that owns the GHCR packages
# (ghcr.io/<IMAGE_OWNER>/solvro-backend, ghcr.io/<IMAGE_OWNER>/solvro-frontend).
IMAGE_OWNER=your-github-username
# Image tag to deploy: `latest` (main), `sha-<short>`, or a version tag like `v0.2.0`.
IMAGE_TAG=latest
