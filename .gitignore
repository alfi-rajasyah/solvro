.vite/

# tsc occasionally compiles top-level config files (vite.config.ts ->
# vite.config.{js,d.ts}); those win over the .ts at runtime and ship a
# stale config. Keep them out of the working tree.
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/tailwind.config.js
frontend/tailwind.config.d.ts

# New UI/ — local-only design reference (HTML mockups + Figma source/PDF).
# Kept out of the repo: the PDF is 163 MB (exceeds GitHub's 100 MB limit)
# and the HTMLs are dev-only previews, not a build target.
New UI/

.env
.env.local
.env.*.local

# Local Docker overrides + the deployed compose (setup.sh inlines it; the
# canonical compose definition lives inside setup.sh, not as a tracked file).
docker-compose.override.yml
docker-compose.yml

# Prisma
backend/prisma/migrations/dev.db*

